{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/artifacts/native/windows-x64",
      "cacheVariables": {
        "NVISION_BUILD_TESTS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-host",
      "displayName": "Linux host",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/artifacts/native/linux-host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "NVISION_BUILD_TESTS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    },
    {
      "name": "linux-host-release",
      "configurePreset": "linux-host"
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-host-release",
      "configurePreset": "linux-host",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
